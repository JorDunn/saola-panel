{
  "statusLine": {
    "type": "command",
    "command": "$HOME/Developer/saola-panel/contrib/claude-code/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh idle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh working"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh subagent-done"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh done"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh attention"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh attention"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/saola-panel/contrib/claude-code/emit.sh ended"
          }
        ]
      }
    ]
  }
}
